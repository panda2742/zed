// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "session": {
    "trust_all_worktrees": true,
  },
  "icon_theme": "Base Charmed Icons",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "theme": {
    "mode": "system",
    "light": "Caelestia",
    "dark": "Caelestia",
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 100,
    },
  },
  "show_edit_predictions": false,
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "tab_bar": { "show": true, "show_nav_history_buttons": false },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "disable_ai": true,
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },
    "C": {
      "tab_size": 4,
      "hard_tabs": true,
    },
    "C++": {
      "tab_size": 4,
      "hard_tabs": true,
    },
  },
  "buffer_line_height": "standard",
  "terminal": {
    "shell": {
      "program": "fish",
    },
  },
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrains Mono",
}
